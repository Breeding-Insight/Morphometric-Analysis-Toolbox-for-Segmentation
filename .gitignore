# Model weights (see docs/weights.md). RF-DETR (weights/rf_detr_marker.pth) is
# the one intentional exception: it's committed via Git LFS as an interim
# delivery mechanism (mandatory for both segmentation paths, and Hugging Face
# auto-fetch isn't wired up yet). BiRefNet is not committed -- too large.
# `weights/*` + a negation, not a bare `weights/`, because gitignore can't
# re-include a file whose parent directory is itself excluded.
*.pth
*.pt
*.pkl
*.onnx
weights/*
!weights/rf_detr_marker.pth

# Pipeline run outputs
mats_outputs/
streamlit_outputs/
leaf_morpho_results.csv
leaf_morpho_failures.csv

# Python build / cache
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# OS / editor junk
.DS_Store
.vscode/
.idea/

# AI-assistant working notes (local-only, not shipped)
CLAUDE.md
.claude/
.agents/
