# Model weights (see docs/weights.md). Both checkpoints are committed via Git
# LFS -- RF-DETR (weights/rf_detr_marker.pth, mandatory, fetched on every
# clone) and BiRefNet (weights/birefnet_leaf.pth, optional, excluded from the
# default clone/fetch by .lfsconfig so it's opt-in). Git LFS runs alongside
# Hugging Face auto-fetch as a second delivery channel for collaborators (e.g.
# USDA) who cannot reach huggingface.co.
# `weights/*` + a negation, not a bare `weights/`, because gitignore can't
# re-include a file whose parent directory is itself excluded.
*.pth
*.pt
*.pkl
*.onnx
weights/*
!weights/rf_detr_marker.pth
!weights/birefnet_leaf.pth

# Pipeline run outputs
mats_outputs/
streamlit_outputs/
leaf_morpho_results.csv
leaf_morpho_failures.csv

# Python build / cache
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# OS / editor junk
.DS_Store
.vscode/
.idea/

# AI-assistant working notes (local-only, not shipped)
CLAUDE.md
.claude/
.agents/
